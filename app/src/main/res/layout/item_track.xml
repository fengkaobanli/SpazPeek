<?xml version="1.0" encoding="utf-8"?>
<!-- One active audio track row with a semantic verdict chip -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTrackName"
            style="@style/TextAppearance.SpazPeek.BodyMonoStrong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipVerdict"
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:checkable="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTrackDetail"
        style="@style/TextAppearance.SpazPeek.BodyMono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>