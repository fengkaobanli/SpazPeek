<?xml version="1.0" encoding="utf-8"?>
<!-- Report section card: title + monospace body + optional collapsible raw block -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.SpazPeek.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/card_gap">

    <LinearLayout
        android:id="@+id/sectionInner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/tvSectionTitle"
            style="@style/TextAppearance.SpazPeek.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvSectionBody"
            style="@style/TextAppearance.SpazPeek.BodyMonoStrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textIsSelectable="true" />

        <!-- collapse header (optional) -->
        <LinearLayout
            android:id="@+id/rawHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRawTitle"
                style="@style/TextAppearance.SpazPeek.LabelSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ivExpand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/cd_expand"
                android:src="@drawable/ic_expand" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRawBody"
            style="@style/TextAppearance.SpazPeek.BodyMono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>